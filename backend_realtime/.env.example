# Puerto del servidor (opcional, por defecto 3001)
REALTIME_PORT=3001

# URL del cliente para CORS (opcional, por defecto permite todos los orígenes)
CLIENT_URL=http://localhost:5173

# Credenciales de Firebase Admin
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Debug de señalización WebRTC (opcional, por defecto desactivado)
DEBUG_SIGNALING=0
